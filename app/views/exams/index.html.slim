/ Índice de exámenes — docs/styles.md §5 (jerarquía de página) y §6.9 (filtros).
/ JS hooks preserved: #filterrific_results es el destino del refresco parcial
/ que pinta index.js.erb. No renombrar.
.mt-4
  .ps-page-header
    h1 = t('activerecord.plural.exams')
    - if current_user.admin?
      = link_to new_exam_path, class: "btn btn-primary" do
        = bi_icon("plus-lg", class: "me-1")
        = t('create_new_exam')

  hr

  = form_for_filterrific @filterrific do |f|
    .ps-filters
      .row.g-3.align-items-end
        .col-md-8
          = f.label :sorted_by, t('sort_by'), class: 'form-label'
          = f.select :sorted_by, @filterrific.select_options[:sorted_by], { include_blank: t('select_sort_option') }, { class: 'form-select' }
        .col-md-4
          = f.submit t('apply_filters'), class: 'btn btn-primary me-2'
          = link_to t('reset_filters'), reset_filterrific_url, class: 'btn btn-secondary'

  #filterrific_results
    = render(partial: 'exams/list', locals: { exams: @exams })
