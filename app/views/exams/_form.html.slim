/ Alta y edición de examen — docs/styles.md §5 (jerarquía) y §6.8 (formularios).
/ JS hooks preserved: .flatpickr-input lo inicializa flatpickr_init.js en cada
/ `turbo:load`. No sustituir por `date_field` (§10.7).
.mt-4
  .ps-page-header
    h1
      - if @exam.persisted?
        = "#{t('actions.edit')} #{t('activerecord.models.exam').downcase}"
      - else
        = t('create_new_exam')

  hr

  = simple_form_for @exam do |f|
    = f.error_notification class: 'alert alert-danger'

    .form-inputs
      .row.g-3
        .col-12
          = f.input :title
        .col-md-6
          = f.input :start_date, as: :string, input_html: { class: 'flatpickr-input', data: { date_format: 'Y-m-d H:i', enable_time: true, no_calendar: false, enable_seconds: false } }
        .col-md-6
          = f.input :end_date, as: :string, input_html: { class: 'flatpickr-input', data: { date_format: 'Y-m-d H:i', enable_time: true, no_calendar: false, enable_seconds: false } }

      h2.mt-4 = t('activerecord.plural.questions')
      hr

      #questions-container
        = f.simple_fields_for :questions do |question_fields|
          = render 'question_fields', f: question_fields
        .links.mt-3
          = link_to_add_association t('add_question'), f, :questions, class: "btn btn-outline-primary btn-sm"

    .form-actions.mt-4
      - submit_label = @exam.persisted? ? t('actions.save') : t('create_new_exam')
      = f.button :submit, submit_label, class: "btn btn-primary me-2"
      = link_to t('actions.back'), exams_path, class: "btn btn-secondary"
