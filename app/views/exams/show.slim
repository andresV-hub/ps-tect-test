/ Ficha de examen — docs/styles.md §5 (jerarquía), §6.4 (píldoras),
/ §6.6 (tarjetas), §6.7 (lista de opciones y corrección).
.mt-4
  .ps-page-header
    h1 = @exam.title
    - if @exam.available_now?
      span.ps-pill.ps-pill--live = t('activerecord.user_exam.attributes.status_badge.available')
    - elsif @exam.end_date < Time.current
      span.ps-pill.ps-pill--closed = t('activerecord.user_exam.attributes.status_badge.ended')
    - else
      span.ps-pill.ps-pill--scheduled = t('activerecord.user_exam.attributes.status_badge.not_yet_available')

  hr

  .card.mb-4
    .card-body
      .row.g-3
        .col-md-4
          .text-muted = t('activerecord.attributes.exam.start_date')
          .ps-num = l(@exam.start_date, format: :short)
        .col-md-4
          .text-muted = t('activerecord.attributes.exam.end_date')
          .ps-num = l(@exam.end_date, format: :short)
        .col-md-4
          .text-muted = t('activerecord.messages.exam.total_possible_score_label')
          .ps-num = number_with_precision(@exam.total_score, precision: 2)

  - if current_user.admin?
    h2 = t('activerecord.plural.questions')
    hr
    - if @exam.questions.empty?
      .alert.alert-info = t('activerecord.messages.exam.no_questions_for_this_exam_yet')
    - else
      - @exam.questions.each_with_index do |question, index|
        .card.mb-2
          .card-body
            h5.card-title
              - if question.scorable?
                span.ps-pill.ps-pill--points.float-end = t('activerecord.messages.exam.points', score: question.score, count: question.score)
              = t('activerecord.messages.exam.question_number', index: index + 1, content: question.content)
            p.card-text
              em = "#{t('activerecord.messages.exam.type_label')} #{t("enums.question.question_type.#{question.question_type}")}"
            - if question.text?
              p.text-muted = t('activerecord.messages.exam.free_text_answer')
            - else
              ul.list-group.list-group-flush.mt-2
                - question.question_options.each do |option|
                  li.list-group-item
                    - if option.correct?
                      = bi_icon("check-lg", class: "text-success me-2")
                    - else
                      = bi_icon("x-lg", class: "text-danger me-2")
                    = option.content

    h2.mt-4 = t('activerecord.messages.exam.results_heading')
    hr
    - if @exam.user_exams.empty?
      .alert.alert-info = t('activerecord.messages.exam.no_students_have_taken_this_exam_yet')
    - else
      ul.list-group
        - @exam.user_exams.includes(:user).each do |user_exam|
          li.list-group-item.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
            span
              = user_exam.user.email
              - if user_exam.completed_at.present?
                small.text-muted.ms-2 = t('activerecord.user_exam.messages.completed_at', date: l(user_exam.completed_at, format: :short))
              - else
                span.ps-pill.ps-pill--live.ms-2 = t('activerecord.user_exam.attributes.status_badge.in_progress')
            = link_to t('activerecord.user_exam.messages.view_answers'), edit_user_exam_path(user_exam), class: "btn btn-info btn-sm"

  .mt-4
    - if current_user.admin?
      = link_to "#{t('actions.edit')} #{@exam.title}", edit_exam_path(@exam), class: "btn btn-warning me-2"
      = link_to t('actions.back'), exams_path, class: "btn btn-secondary"
    - else
      = link_to t('actions.back'), exams_path, class: "btn btn-secondary me-2"
      - if @exam.available_now?
        - user_exam = @exam.user_exams.find_by(user: current_user)
        - if user_exam&.completed_at.present?
          = link_to t('activerecord.messages.exam.view_my_results'), user_exam_path(user_exam), class: "btn btn-primary"
        - else
          = link_to t('activerecord.messages.exam.take_exam'), new_exam_user_exam_path(@exam), class: "btn btn-primary"

  - unless current_user.admin?
    - if @exam.available_now?
      .alert.alert-warning.mt-3 = t('activerecord.messages.exam.this_exam_is_open', date: l(@exam.end_date, format: :short))
    - elsif @exam.end_date < Time.current
      .alert.alert-warning.mt-3 = t('activerecord.messages.exam.this_exam_has_ended', date: l(@exam.end_date, format: :short))
    - else
      .alert.alert-warning.mt-3 = t('activerecord.messages.exam.this_exam_not_yet_available', date: l(@exam.start_date, format: :short))
