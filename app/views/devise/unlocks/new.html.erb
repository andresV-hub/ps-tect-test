<%# Reenviar instrucciones de desbloqueo — docs/styles.md §6.12.
    El modelo User no activa :lockable hoy, así que esta ruta no existe;
    la vista se mantiene alineada por si se habilita. %>
<div class="ps-auth-card">
  <%= render "devise/shared/auth_header",
             title: t("unlocks.resend_title"),
             lead: t("unlocks.resend_lead") %>

  <%= simple_form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }) do |f| %>
    <%= f.error_notification class: "alert alert-danger" %>
    <%= f.full_error :unlock_token %>

    <div class="form-inputs">
      <%= f.input :email,
                  required: true,
                  autofocus: true,
                  label: t("defaults.email"),
                  input_html: { autocomplete: "email" } %>
    </div>

    <div class="form-actions">
      <%= f.button :submit, t("unlocks.resend_button"), class: "btn btn-primary w-100" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
