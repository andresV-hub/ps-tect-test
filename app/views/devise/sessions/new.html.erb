<%# Iniciar sesión — docs/styles.md §6.12. %>
<div class="ps-auth-card">
  <%= render "devise/shared/auth_header",
             title: t("defaults.log_in_title"),
             lead: t("defaults.log_in_lead") %>

  <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="form-inputs">
      <%= f.input :email,
                  required: false,
                  autofocus: true,
                  label: t("defaults.email"),
                  input_html: { autocomplete: "email" } %>
      <%= f.input :password,
                  required: false,
                  label: t("defaults.password"),
                  input_html: { autocomplete: "current-password" } %>
      <%= f.input :remember_me, as: :boolean, label: t("defaults.remember_me") if devise_mapping.rememberable? %>
    </div>

    <div class="form-actions">
      <%= f.button :submit, t("defaults.log_in"), class: "btn btn-primary w-100" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
