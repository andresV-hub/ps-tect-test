/ Listado de mis entregas — docs/styles.md §6.3 (tablas), §6.4 (píldoras y
/ puntuación). La puntuación nunca se muestra sin su máximo al lado.
- if user_exams.empty?
  .alert.alert-info = t('activerecord.user_exam.messages.no_user_exams_yet')
- else
  .table-responsive
    table.table.table-hover.table-striped
      thead
        tr
          th = t('activerecord.models.exam')
          th = t('activerecord.user_exam.messages.your_score')
          th = t('activerecord.user_exam.messages.completed_on')
          th = t('actions.name')
      tbody
        - user_exams.each do |user_exam|
          tr
            td = link_to user_exam.exam.title, user_exam_path(user_exam)
            td
              - if user_exam.completed_at.present?
                span.ps-score
                  span.ps-score__value = number_with_precision(user_exam.score, precision: 2)
                  span.ps-score__total = "/ #{number_with_precision(user_exam.exam.total_score, precision: 2)}"
              - else
                span.ps-pill.ps-pill--live = t('activerecord.user_exam.attributes.status_badge.in_progress')
            td
              - if user_exam.completed_at.present?
                = l(user_exam.completed_at, format: :short)
              - else
                span.text-muted = "—"
            td.text-nowrap
              - if user_exam.completed_at.present?
                = link_to t('activerecord.messages.exam.view_my_results'), user_exam_path(user_exam), class: "btn btn-info btn-sm"
              - else
                = link_to t('activerecord.messages.exam.continue_exam'), new_exam_user_exam_path(user_exam.exam), class: "btn btn-primary btn-sm"
  = will_paginate user_exams
