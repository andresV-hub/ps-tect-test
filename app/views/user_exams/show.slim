/ Resultado de una entrega — docs/styles.md §6.4 (la puntuación es el dato
/ protagonista), §6.6 (tarjetas) y §6.7 (corrección con icono y texto).
.mt-4
  .ps-page-header
    h1 = @user_exam.exam.title
    - if @user_exam.completed_at.present?
      span.ps-pill.ps-pill--done = t('activerecord.user_exam.attributes.status_badge.completed')
    - else
      span.ps-pill.ps-pill--live = t('activerecord.user_exam.attributes.status_badge.not_completed')

  hr

  .card.mb-4
    .card-body
      .row.g-3
        .col-md-6
          .text-muted = t('activerecord.user_exam.messages.your_score')
          - if @user_exam.completed_at.present?
            span.ps-score
              span.ps-score__value = number_with_precision(@user_exam.score, precision: 2)
              span.ps-score__total = "/ #{number_with_precision(@user_exam.exam.total_score, precision: 2)}"
          - else
            span.ps-pill.ps-pill--live = t('activerecord.user_exam.attributes.status_badge.not_completed')
        .col-md-6
          .text-muted = t('activerecord.user_exam.messages.completed_on')
          - if @user_exam.completed_at.present?
            .ps-num = l(@user_exam.completed_at, format: :short)
          - else
            .text-muted = "—"

  h2 = t('activerecord.user_exam.messages.your_answers')
  hr

  - if @user_exam.user_answers.empty?
    .alert.alert-info = t('activerecord.user_exam.messages.no_answers_recorded')
  - else
    - @user_exam.user_answers.includes(question: :question_options).each_with_index do |user_answer, index|
      - question = user_answer.question
      .card.mb-2
        .card-body
          h5.card-title
            - if question.scorable?
              span.ps-pill.ps-pill--points.float-end = t('activerecord.messages.exam.points', score: question.score, count: question.score)
            = t('activerecord.messages.exam.question_number', index: index + 1, content: question.content)
          p.card-text
            em = "#{t('activerecord.messages.exam.type_label')} #{t("enums.question.question_type.#{question.question_type}")}"

          - if question.text?
            p
              strong.d-block = t('activerecord.user_exam.messages.your_answer')
              = user_answer.text_answer.presence || content_tag(:span, t('activerecord.user_exam.messages.no_answer_provided'), class: "text-muted")
          - else
            strong.d-block = t('activerecord.user_exam.messages.your_selection')
            ul.list-group.list-group-flush.mt-2
              - question.question_options.each do |option|
                li.list-group-item
                  - if user_answer.question_options.include?(option)
                    = bi_icon("check-circle-fill", class: "text-primary me-2")
                    strong = option.content
                  - else
                    = bi_icon("circle", class: "text-muted me-2")
                    = option.content

            strong.d-block.mt-3 = t('activerecord.user_exam.messages.correct_answers')
            ul.list-group.list-group-flush.mt-2
              - question.question_options.select(&:correct?).each do |option|
                li.list-group-item
                  = bi_icon("check-lg", class: "text-success me-2")
                  = option.content

  .mt-4
    = link_to t('activerecord.user_exam.messages.back_to_user_exams'), user_exams_path, class: "btn btn-secondary me-2"
    - if @user_exam.exam.available_now? && @user_exam.completed_at.blank?
      = link_to t('activerecord.user_exam.messages.edit_answers'), edit_user_exam_path(@user_exam), class: "btn btn-primary"
