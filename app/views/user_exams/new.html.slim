/ Alta de una entrega — docs/styles.md §5 (jerarquía), §6.6 (una tarjeta por
/ pregunta), §6.8 (simple_form).
/
/ Esta vista NO renderiza `_form`: tiene su propio simple_form, mientras que
/ `edit` sí usa el partial. Ambas quedan alineadas — misma estructura visual y
/ los mismos controles por tipo de pregunta. Ver docs/styles.md §6.8.
.mt-4
  .ps-page-header
    h1
      - if @user_exam.persisted?
        = t('user_exams.continue_exam_heading', title: @exam.title)
      - else
        = t('user_exams.take_exam_heading', title: @exam.title)
    / Píldora corta + la causa al lado, no la frase entera en mayúsculas (§6.4).
    .d-flex.align-items-center.gap-2
      span.ps-pill.ps-pill--live = t('activerecord.user_exam.attributes.status_badge.available')
      span.text-muted = t('activerecord.messages.exam.this_exam_is_open', date: l(@exam.end_date, format: :short))

  hr

  = simple_form_for [@exam, @user_exam] do |f|
    = f.error_notification class: 'alert alert-danger'

    .form-inputs
      = f.simple_fields_for :user_answers do |answer_fields|
        - question = answer_fields.object.question
        .card.mb-3
          .card-body
            h5.card-title
              - if question.scorable?
                span.ps-pill.ps-pill--points.float-end = t('activerecord.messages.exam.points', score: question.score, count: question.score)
              = t('activerecord.messages.exam.question_number', index: answer_fields.index + 1, content: question.content)
            = answer_fields.hidden_field :question_id

            - if question.text?
              .mt-3
                = answer_fields.input :text_answer,
                        as: :text,
                        label: false,
                        placeholder: t('user_exams.text_answer_placeholder'),
                        input_html: { rows: 4 }
            - elsif question.single_choice?
              / Radios, no casillas: la pregunta admite una sola opción y el
              / control tiene que decir la verdad. El nombre conserva el `[]`
              / porque el controlador permite `question_option_ids: []`, y el
              / agrupado del radio lo hace el propio atributo `name`.
              .mt-3
                p.text-muted.mb-2 = t('user_exams.select_one_label')
                - question.question_options.each do |opt|
                  .form-check
                    = radio_button_tag "user_exam[user_answers_attributes][#{answer_fields.index}][question_option_ids][]", opt.id, answer_fields.object.question_options.include?(opt), id: "answer_#{answer_fields.index}_option_#{opt.id}", class: 'form-check-input'
                    = label_tag "answer_#{answer_fields.index}_option_#{opt.id}", opt.content, class: 'form-check-label'
            - elsif question.multiple_choice?
              .mt-3
                p.text-muted.mb-2 = t('user_exams.select_all_label')
                = answer_fields.collection_check_boxes :question_option_ids,
                        question.question_options,
                        :id,
                        :content,
                        item_wrapper_class: 'form-check',
                        label_method: :content,
                        checked: answer_fields.object.question_options.pluck(:id)

    .form-actions.mt-4
      = f.button :submit, t('user_exams.submit_exam_button'), class: "btn btn-primary me-2"
      = link_to t('cancel_button'), exams_path, class: "btn btn-secondary"
